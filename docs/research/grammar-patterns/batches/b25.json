  {
    "id": "to-wa",
    "form": "〜とは",
    "variants": [
      "〜とは思わなかった",
      "〜なんて (spoken)"
    ],
    "meaning": "that (of all things)! / X means; surprise or definition",
    "kind": "construction",
    "register": "neutral",
    "level": "N1",
    "sources": {
      "jlptsensei": "N1",
      "bunpro": "N1",
      "jt4y": "N1"
    },
    "prototype": false,
    "notes": "Two uses: surprise (まさか〜とは) and definition (AとはBだ). Plain topic marking とは is very common; matcher must separate the senses."
  },
  {
    "id": "to-iu-ka",
